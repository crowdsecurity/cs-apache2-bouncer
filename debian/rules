#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --with apache2

override_dh_auto_configure:
	dh_auto_configure -- --with-apxs=/usr/bin/apxs2 --enable-werror

# Deliberately not a full "make install": dh_apache2 owns the module and the
# mods-available pair here - it is what emits the apache2-api dependency and
# the enmod/dismod maintainer-script snippets - so make supplies only the
# bouncer's own files.
override_dh_auto_install:
	$(MAKE) install-bouncer-data DESTDIR=$(CURDIR)/debian/tmp

# Forced rather than excluded from dh_fixperms, which is how the other crowdsec
# bouncers do it: the mode is then independent of what the install step
# happened to use. It matters most for the config, which holds the API key -
# scripts/_bouncer.sh rewrites that file with a plain redirect, preserving
# whatever mode it already has rather than imposing one, so a world-readable
# config stays world-readable with the key in it.
execute_after_dh_fixperms:
	chmod 0600 debian/crowdsec-apache2-bouncer/etc/crowdsec/bouncers/crowdsec-apache2-bouncer.conf
	chmod 0600 debian/crowdsec-apache2-bouncer/usr/lib/crowdsec-apache2-bouncer/_bouncer.sh
